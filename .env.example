GROQ_API_KEY=your_groq_api_key
DATABASE_URL=mongodb://localhost:27017/resume
HOSTED_URL=http://localhost:3000

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_in_production
JWT_SECRET=your-super-secret-jwt-key-change-this

# Rate limiting (in ms)
RATE_LIMIT_WINDOW=600000
RATE_LIMIT_MAX_REQUESTS=10

# Cache (in seconds)
CACHE_DURATION=3600

# Encryption key for GitHub token (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
GITHUB_TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here
